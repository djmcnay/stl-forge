/*
    PARAMETRIC STAR / FLOWER GENERATOR  (PROVENANCE - VERBATIM)
    ============================================================

    This file is the principal-supplied generator, committed UNCHANGED as
    the provenance record for the bead-star family (the same role
    parametric_heart_reference.scad plays for bead_heart).

    Source: ChatGPT, supplied 17 Oct 2026. Parameter names here are
    ChatGPT's own (`depth`); the production template
    templates/bead_star.scad renames `depth` -> `petal_depth` and
    re-exposes the enclosing diameter as `width` to match the bead
    family convention. Do NOT edit this file: any behavioural change
    belongs in templates/bead_star.scad.

    Parameters:

    diameter       Enclosing circle diameter
    points         Number of points / petals
    roundness      1..20
    depth          1..10

    Defaults:
        diameter = 50
        points = 5
        roundness = 1
        depth = 5

    Roundness:
         1 = Sharp star
        10 = Bulbous star
        20 = Flower

    Depth:
         1 = Shallow valleys
         5 = Original star proportions
        10 = Deep valleys

    No external libraries required.
*/


// ==================================================
// 1. MATHEMATICAL HELPERS
// ==================================================

function clamp(x, lo, hi) =
    max(lo, min(hi, x));


function lerp(a, b, t) =
    a*(1-t) + b*t;


function smoothstep(t) =
    let(x = clamp(t, 0, 1))
    x*x*(3-2*x);


// ==================================================
// 2. AUTOMATIC STAR VALLEY RATIO
// ==================================================

/*
    Original inner/outer radius ratio.

    At depth=5, the generator preserves
    this automatically determined ratio.

    This keeps 5, 6, 8 and 10 pointed
    stars proportionally attractive.
*/

function star_valley_ratio(n) =
    1 - 1.05*sin(180/n);


// ==================================================
// 3. INDEPENDENT VALLEY DEPTH
// ==================================================

/*
    depth = 1:
        Inner radius = 88% of outer radius.

    depth = 5:
        Inner radius uses original
        automatic star proportions.

    depth = 10:
        Inner radius = 8% of outer radius.

    IMPORTANT:

    This function depends on points and depth.

    It does NOT depend on roundness.
*/

function star_inner_ratio(n, depth) =

    let(
        d = clamp(depth, 1, 10),

        base = star_valley_ratio(n)
    )

    d <= 5

        ? lerp(
            0.88,
            base,
            (d-1)/4
        )

        : lerp(
            base,
            0.08,
            (d-5)/5
        );


// ==================================================
// 4. SHARP STAR RADIAL PROFILE
// ==================================================

/*
    u=0: outward tip
    u=1: inner valley

    Calculates the exact radial intersection
    with the straight edge joining the tip
    and valley.

    This preserves straight polygon edges
    when roundness=1.
*/

function sharp_radius(u, n, valley) =

    let(
        a = 180/n,

        theta = a*u
    )

    valley*sin(a)
    /
    (
        valley*sin(a-theta)
        + sin(theta)
    );


// ==================================================
// 5. SMOOTH ANGULAR TRANSITION
// ==================================================

/*
    Smooths the curve near the outward
    tip and the inner valley.

    width=0:
        Original sharp star.

    width>0:
        Zero radial derivative at the
        tip and valley.

    Intermediate roundness values therefore
    progressively remove the sharp corners.

    The central portion of the interval
    is preserved.
*/

function smooth_angle(u, width) =

    width <= 0
    ? u

    : u < width
    ? (
        2*u*u/width
        - pow(u,3)/pow(width,2)
    )

    : u > 1-width
    ? let(v = 1-u)
        1 - (
            2*v*v/width
            - pow(v,3)/pow(width,2)
        )

    : u;


// ==================================================
// 6. UNIFIED STAR / FLOWER RADIAL PROFILE
// ==================================================

/*
    This is the main shape-generating function.

    Inputs:

        u          0..1
        n          Number of points
        roundness  1..20
        depth      1..10

    Returns a NORMALISED radius.

    The output is bounded by:

        valley <= radius <= 1

    Therefore the outline cannot extend
    beyond the enclosing circle.

    Depth controls the valley radius.

    Roundness controls the curvature.

    These are independent parameters.
*/

function star_radius(
    u,
    n,
    roundness,
    depth
) =

    let(

        r = clamp(roundness, 1, 20),

        // Independent valley depth
        valley = star_inner_ratio(
            n,
            depth
        ),

        // ----------------------------------
        // SHARP -> BULBOUS
        // Roundness 1..10
        // ----------------------------------

        q = clamp(
            (r-1)/9,
            0,
            1
        ),

        remapped_u = smooth_angle(
            u,
            0.32*q
        ),

        sharp = sharp_radius(
            remapped_u,
            n,
            valley
        ),

        bulbous =
            valley +
            (1-valley)*pow(
                cos(90*u),
                2
            ),

        original_star =
            (1-q)*sharp
            + q*bulbous,


        // ----------------------------------
        // BULBOUS -> FLOWER
        // Roundness 10..20
        // ----------------------------------

        t = smoothstep(
            (r-10)/10
        ),

        petal_power =
            2 + 2*t,

        flower =
            valley +
            (1-valley) *
            (
                1 -
                pow(
                    sin(90*u),
                    petal_power
                )
            )

    )

    r <= 10
        ? original_star
        : flower;


// ==================================================
// 7. GENERATE 2D STAR / FLOWER VERTICES
// ==================================================

/*
    Generates points around the complete
    outline.

    Each outward point is positioned
    exactly on the enclosing circle.

    The first point is vertically upwards.

    Each angular sector has:

        samples_per_half samples from
        the outer tip to the valley

        samples_per_half samples from
        the valley to the next outer tip

    Integer sample indices guarantee that
    every outward tip is included exactly.
*/

function star_vertices(
    diameter = 50,
    points = 5,
    roundness = 1,
    depth = 5,
    samples_per_half = 64
) =

    let(

        R = diameter/2,

        n = points,

        samples = max(
            8,
            floor(samples_per_half)
        ),

        total_samples =
            2*n*samples
    )

    [

        for (i = [0:total_samples-1])

            let(

                // Angular position
                theta =
                    360*i/total_samples,

                // Integer position within
                // the current star sector
                j = i % (2*samples),

                // 0 at outward tips,
                // 1 at valleys
                u =
                    min(
                        j,
                        2*samples-j
                    ) / samples,

                // Normalised radial profile
                radial_fraction =
                    star_radius(
                        u,
                        n,
                        roundness,
                        depth
                    ),

                // Scale to circle diameter
                radius =
                    R*radial_fraction,

                // Orient one tip vertically
                angle =
                    90-theta
            )

            [
                radius*cos(angle),
                radius*sin(angle)
            ]

    ];


// ==================================================
// 8. PRIMARY USER-FACING MODULE
// ==================================================

module star_2d(
    diameter = 50,
    points = 5,
    roundness = 1,
    depth = 5,
    samples_per_half = 64
) {

    assert(
        diameter > 0,
        "Diameter must be positive"
    )

    assert(
        points >= 3
        && points == floor(points),
        "Points must be an integer >= 3"
    )

    assert(
        roundness >= 1
        && roundness <= 20,
        "Roundness must be 1..20"
    )

    assert(
        depth >= 1
        && depth <= 10,
        "Depth must be 1..10"
    )

    polygon(
        points = star_vertices(
            diameter,
            points,
            roundness,
            depth,
            samples_per_half
        )
    );

}


// ==================================================
// 9. OPTIONAL DEMONSTRATION
// ==================================================

/*
    Change to false when incorporating
    this file into a larger project.

    The demo displays different combinations
    of roundness and depth.

    All sketches use identical enclosing
    circle diameters.
*/

preview_examples = true;


if (preview_examples) {

    $fn = 180;

    D = 50;

    // Columns: four shape combinations
    roundness_values = [
        1,
        10,
        20,
        20
    ];

    depth_values = [
        5,
        5,
        5,
        9
    ];

    // Rows: different numbers of petals
    point_counts = [
        5,
        6,
        8,
        10
    ];

    for (row = [0:3]) {

        for (col = [0:3]) {

            translate([
                (col-1.5)*65,
                (1.5-row)*65
            ]) {

                // Enclosing circle
                color([0.7, 0.7, 0.7])

                    difference() {

                        circle(d=D);

                        circle(d=D-0.3);

                    }

                // Star / flower sketch
                color([0.25, 0.25, 0.25])

                    star_2d(
                        diameter = D,
                        points =
                            point_counts[row],
                        roundness =
                            roundness_values[col],
                        depth =
                            depth_values[col]
                    );

            }

        }

    }

}
